BOT_TOKEN=
ALLOWED_USER_ID=
VAULT_PATH=
# Host user that owns the vault files. Used by docker compose, not by the bot process itself.
PUID=
PGID=
# Optional SOCKS proxy for all Telegram traffic. Leave unset to connect directly.
PROXY_URL=
# Folder inside the vault for downloaded media.
ATTACHMENTS_DIR=Attachments
# IANA timezone for publication times in filenames and dates.
TIMEZONE=Europe/Moscow
# How long a comment stays pending while forwards arrive, in milliseconds.
COMMENT_WINDOW_MS=3000
# How long to buffer album parts before saving them as one note, in milliseconds.
ALBUM_WINDOW_MS=1500

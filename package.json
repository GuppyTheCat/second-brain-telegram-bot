{
  "name": "second-brain-telegram-bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=25"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "node --require ./scripts/typescript-6-for-eslint.cjs ./node_modules/eslint/bin/eslint.js .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "grammy": "^1.46.0",
    "socks-proxy-agent": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-6": "npm:typescript@6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.3"
  }
}
